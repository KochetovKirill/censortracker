{
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": "images/icons/128x128/default.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{0877ae40-388e-423e-93b1-fb128938d464}",
      "strict_min_version": "91.1.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_security_policy": "script-src 'self'; object-src 'self';",
  "manifest_version": 2,
  "permissions": [
    "<all_urls>",
    "webRequest",
    "webRequestBlocking",
    "alarms",
    "activeTab",
    "clipboardRead",
    "clipboardWrite",
    "management",
    "notifications",
    "proxy",
    "storage",
    "tabs",
    "unlimitedStorage"
  ]
}
